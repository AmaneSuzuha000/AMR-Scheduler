<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="amr_metric">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
        </solver>
      </ode>
    </physics>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <plugin name="state" filename="libgazebo_ros_state.so" />
    <model name="front_wall">
      <static>true</static>
      <pose>3.1 0 0.6 0 0 0.0</pose>
      <link name="body">
        <collision name="solid">
          <geometry>
            <box>
              <size>0.2 6 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 6 1.2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.35 0.45 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="left_wall">
      <static>true</static>
      <pose>0 3.1 0.6 0 0 0.0</pose>
      <link name="body">
        <collision name="solid">
          <geometry>
            <box>
              <size>6 0.2 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.2 1.2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.35 0.45 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="right_wall">
      <static>true</static>
      <pose>0 -3.1 0.6 0 0 0.0</pose>
      <link name="body">
        <collision name="solid">
          <geometry>
            <box>
              <size>6 0.2 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6 0.2 1.2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.35 0.45 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>