<?xml version="1.0"?>
<robot name="scout_mini" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- GZ-1 SCOUT Mini differential (not omni). Meshes adapted from AgileX / community assets. -->
  <xacro:arg name="use_lidar" default="true"/>
  <xacro:arg name="drive_mode" default="planar"/>

  <!-- Geometry (community fork values; wheel radius 0.08 m) -->
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_separation" value="0.416503"/>
  <xacro:property name="wheelbase" value="0.463951"/>

  <!-- base_footprint on ground, base_link at axle height -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 -1.57"/>
      <geometry>
        <mesh filename="package://scout_gazebo_description/meshes/scout_mini_base_link.dae"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="23.0"/>
      <inertia ixx="0.35" ixy="0" ixz="0" iyy="0.55" iyz="0" izz="0.70"/>
    </inertial>
  </link>

  <!-- Wheel macro -->
  <xacro:macro name="wheel" params="prefix xyz rpy axis">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://scout_gazebo_description/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="0.084"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.5"/>
        <inertia ixx="0.0065" ixy="0" ixz="0" iyy="0.0065" iyz="0" izz="0.0096"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <gazebo reference="${prefix}_wheel_link">
      <mu1>50.0</mu1>
      <mu2>50.0</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxContacts>8</maxContacts>
    </gazebo>
  </xacro:macro>

  <!-- Positions relative to base_link (axle height frame) -->
  <xacro:wheel prefix="front_left"
    xyz="${wheelbase/2} ${wheel_separation/2} 0"
    rpy="-1.57 0 0" axis="0 0 1"/>
  <xacro:wheel prefix="rear_left"
    xyz="${-wheelbase/2} ${wheel_separation/2} 0"
    rpy="-1.57 0 0" axis="0 0 1"/>
  <xacro:wheel prefix="front_right"
    xyz="${wheelbase/2} ${-wheel_separation/2} 0"
    rpy="-1.57 0 0" axis="0 0 1"/>
  <xacro:wheel prefix="rear_right"
    xyz="${-wheelbase/2} ${-wheel_separation/2} 0"
    rpy="-1.57 0 0" axis="0 0 1"/>

  <!-- Optional lidar (virtual; not on bare chassis) -->
  <xacro:if value="$(arg use_lidar)">
    <link name="laser_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.05" length="0.06"/></geometry>
        <material name="laser_grey"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.05" length="0.06"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_link"/>
      <origin xyz="0.15 0 0.18" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- Gazebo Classic ROS2 plugins -->
  <xacro:include filename="$(find scout_gazebo_description)/urdf/scout_mini.gazebo.xacro"/>

</robot>
